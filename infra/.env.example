# Скопируйте в infra/.env перед docker compose up:
#   cp .env.example .env

DB_NAME=devopsforge
DB_USER=devopsforge
DB_PASSWORD=devopsforge123
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# UI через nginx (порт 80) — рекомендуется:
VITE_API_URL=http://localhost/api

# Если открывать напрямую http://localhost:5173 — раскомментируйте:
# VITE_API_URL=http://localhost:8000/api

CHOKIDAR_USEPOLLING=true
